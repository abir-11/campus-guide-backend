model User {
  id                   String          @id @default(uuid())
  name                 String          @db.VarChar(255)
  email                String          @unique
  password             String
  role                 Role            @default(STUDENT)
  phoneNumber          String?
  status               Status          @default(ACTIVE)
  departmentId         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  mentorId             String?
  events               Events[]
  achievements         Achievement[]
  mentorBookings       Booking[]       @relation("MentorBookings")
  studentBookings      Booking[]       @relation("StudentBookings")
  campusAlerts         CampusAlert[]
  mentorProfileDetails MentorProfile?
  mentorProfile        Mentor?         @relation("MentorUser")
  news                 News[]
  profiles             Profile?
  researchGrants       ResearchGrant[]
  resources            Resource[]
  services             Service[]       @relation("MentorServices")
  department           Department?     @relation(fields: [departmentId], references: [id])

  @@map("users")
}
