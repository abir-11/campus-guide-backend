model Department {
  id             String           @id @default(uuid())
  departmentName String           @unique @db.VarChar(255)
  description    String?          @db.VarChar(500)
  status         DepartmentStatus @default(ACTIVE)

  users          User[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@map("departments")
}
