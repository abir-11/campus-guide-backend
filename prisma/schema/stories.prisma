model Story {
  id        String   @id @default(uuid())
  title     String
  excerpt   String
  body      String
  image     String?
  published Boolean  @default(false)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([date])
  @@map("stories")
}
