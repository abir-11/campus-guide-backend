model ResearchGrant {
  id              String   @id @default(uuid())
  title           String   @db.VarChar(255)
  description     String?  @db.VarChar(255)
  amount          Float
  status          ResearchGrantStatus   @default(PENDING)
  researcherId   String
  user            User     @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("research_grants")
}