model ResearchGrant {
  id           String              @id @default(uuid())
  title        String              @db.VarChar(255)
  description  String?             @db.VarChar(255)
  amount       Float
  status       ResearchGrantStatus @default(PENDING)
  researcherId String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@map("research_grants")
}
